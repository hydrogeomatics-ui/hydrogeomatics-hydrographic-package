# Default deny: only reviewed source and controls may be added.
*
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/requirements.txt
!/hydrographic_package.py
!/start_windows.cmd
!/tests/
!/tests/test_source_bundle.py
!/modules/
!/modules/*.py
!/scripts/
!/scripts/check_publication.py
!/.githooks/
!/.githooks/pre-commit
!/.githooks/pre-push
!/.github/
!/.github/workflows/
!/.github/workflows/security.yml

!/LICENSE
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/bug_report.yml
!/.github/ISSUE_TEMPLATE/feature_request.yml
